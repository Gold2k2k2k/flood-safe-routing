# Server & API
PORT=8000
NODE_ENV=development

# Map & Routing Engine
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
ROUTING_ENGINE_URL=http://localhost:8080

# Traffic Camera Ingestion (e.g. camera.0511.vn or public municipal feeds)
CAMERA_FEED_BASE_URL=https://camera.0511.vn
CAMERA_POLL_INTERVAL_SECONDS=30

# AI Vision Service
AI_VISION_PROVIDER=gemini
AI_VISION_API_KEY=your_api_key_here
FLOOD_ALERT_THRESHOLD=0.65
