# Server & Runtime Mode
PORT=8000
NODE_ENV=development
# Set USE_MOCK_FALLBACK=true so contributors can run Frontend/Backend immediately without API keys
USE_MOCK_FALLBACK=true
VITE_USE_MOCK_FALLBACK=true
VITE_API_BASE_URL=http://localhost:8000

# Google Maps Platform (Maps JS API & Routes API)
GOOGLE_MAPS_API_KEY=your_google_maps_server_api_key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_api_key

# Gemini Vision (Multimodal Flood Detection)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
FLOOD_ALERT_THRESHOLD=0.65

# Firebase / Google Cloud (Real-time Sync & Media Storage)
FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Traffic Camera Ingestion (e.g. camera.0511.vn)
CAMERA_FEED_BASE_URL=https://camera.0511.vn
CAMERA_POLL_INTERVAL_SECONDS=30
